cmake_minimum_required(VERSION 3.20)
if(NOT SAM_CAPTURE_BINARY OR NOT SAM_CAPTURE_OUTPUT OR NOT DEFINED SAM_CAPTURE_TILED)
    message(FATAL_ERROR "CPU capture check requires binary, output and tiled mode")
endif()
if(SAM_CAPTURE_TILED)
    execute_process(COMMAND "${SAM_CAPTURE_BINARY}" --check-tiled-support
        RESULT_VARIABLE capability OUTPUT_VARIABLE capability_output ERROR_VARIABLE capability_error)
    if(capability EQUAL 77)
        message(STATUS "SAM_CPU_TILED_UNAVAILABLE: ${capability_output}")
        return()
    elseif(NOT capability EQUAL 0)
        message(FATAL_ERROR "CPU tiled capability check failed: ${capability_output} ${capability_error}")
    endif()
endif()
file(REMOVE_RECURSE "${SAM_CAPTURE_OUTPUT}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "GGML_CPU_TILED_MM=${SAM_CAPTURE_TILED}" "GGML_CPU_TILED_MM_FORCE=${SAM_CAPTURE_TILED}"
    "${SAM_CAPTURE_BINARY}" --output "${SAM_CAPTURE_OUTPUT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CPU kernel boundary capture failed: ${output} ${error}")
endif()
file(READ "${SAM_CAPTURE_OUTPUT}/report.json" report)
string(JSON complete GET "${report}" complete)
string(JSON count GET "${report}" captures)
if(NOT complete OR NOT count EQUAL 96 OR NOT report MATCHES "\"path\":\"dot\"")
    message(FATAL_ERROR "CPU capture lost real dot boundaries: ${output}")
endif()
if(SAM_CAPTURE_TILED AND NOT report MATCHES "\"path\":\"tiled\"")
    message(FATAL_ERROR "CPU tiled boundary was not actually executed")
endif()
if(NOT SAM_CAPTURE_TILED AND report MATCHES "\"path\":\"tiled\"")
    message(FATAL_ERROR "CPU dot-only check unexpectedly used tiled")
endif()
file(REMOVE_RECURSE "${SAM_CAPTURE_OUTPUT}")
