@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# SAM-prepared GGML installs its libraries and headers next to this package;
# the exported package carries them as plain imported targets. A caller-owned
# GGML must provide an importable CMake package defining ggml::ggml.
@SAM_GGML_DEPENDENCY_FINDS@
@SAM_GGML_PACKAGE_FIND@
@SAM_GGML_OPENMP_TARGET_CHECK@

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/samDependencies.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/samDependencies.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/samTargets.cmake")

check_required_components(sam)
